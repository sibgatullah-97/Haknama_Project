# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=generate-a-secure-random-secret-key-for-production

# Upload limits
MAX_CONTENT_LENGTH=16777216

# Optional API Keys (Fallback demo mode is active if left empty)
OPENAI_API_KEY=
GOOGLE_API_KEY=
TRANSLATION_API_KEY=

# Tesseract Path override (Optional for Windows installations)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe